   "source": [
    "## Evaluation Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Metrics ready.\n"
     ]
    }
   ],
   "source": [
    "def ece(y_true, y_pred, n_bins=10):\n",
    "    \"\"\"Expected Calibration Error\"\"\"\n",
    "    bin_edges = np.linspace(0, 1, n_bins + 1)\n",
    "    error = 0.0\n",
    "    for i in range(len(bin_edges) - 1):\n",
    "        mask = (y_pred >= bin_edges[i]) & (y_pred < bin_edges[i + 1])\n",
    "        if mask.sum() > 0:\n",
    "            avg_pred = y_pred[mask].mean()\n",
    "            avg_true = y_true[mask].mean()\n",
    "            weight = mask.sum() / len(y_true)\n",
    "            error += weight * abs(avg_pred - avg_true)\n",
    "    return error\n",
    "\n",
    "def evaluate(y_true, y_pred, name):\n",
    "    \"\"\"Comprehensive evaluation\"\"\"\n",
    "    return {\n",
    "        'Model': name,\n",
    "        'Brier Score': brier_score_loss(y_true, y_pred),\n",
    "        'Log-Loss': log_loss(y_true, y_pred),\n",
    "        'ECE': ece(y_true, y_pred),\n",
    "        'AUC': roc_auc_score(y_true, y_pred)\n",
    "    }\n",
    "\n",
    "print('Metrics ready.')"
   ]
  },
