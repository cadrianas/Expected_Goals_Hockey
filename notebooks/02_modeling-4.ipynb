    "# Prepare predictions for visualization\n",
    "pred_dict = {\n",
    "    'LR (base)': y_pred_base,\n",
    "    'LR (+ 3v3)': y_pred_ctx,\n",
    "    'LR (+ int)': y_pred_int,\n",
    "    'LR (calib)': y_pred_calib\n",
    "}\n",
    "\n",
    "# Add MoneyPuck if available\n",
    "if xgoal_col:\n",
    "    pred_dict = {xgoal_col: val_data[xgoal_col].values, **pred_dict}\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Calibration curves\n",
    "ax = axes[0]\n",
    "for name, preds in pred_dict.items():\n",
    "    prob_true, prob_pred = calibration_curve(y_val, preds, n_bins=10)\n",
    "    ax.plot(prob_pred, prob_true, marker='o', label=name, linewidth=2)\n",
    "\n",
    "ax.plot([0, 1], [0, 1], 'k--', label='Perfect', linewidth=2)\n",
    "ax.set_xlabel('Predicted Probability', fontsize=11, fontweight='bold')\n",
    "ax.set_ylabel('Actual Frequency', fontsize=11, fontweight='bold')\n",
    "ax.set_title('Calibration Curves: All Models', fontsize=12, fontweight='bold')\n",
    "ax.legend(loc='lower right', fontsize=9)\n",
    "ax.grid(True, alpha=0.3)\n",
    "ax.set_xlim(-0.05, 1.05)\n",
    "ax.set_ylim(-0.05, 1.05)\n",
    "\n",
    "# ECE comparison\n",
    "ax = axes[1]\n",
    "models = [r['Model'] for r in results]\n",
    "eces = [r['ECE'] for r in results]\n",
    "colors = ['#d62728' if 'Money' in m else '#1f77b4' if 'calib' not in m else '#2ca02c' for m in models]\n",
    "bars = ax.bar(range(len(models)), eces, color=colors, alpha=0.7, edgecolor='black')\n",
    "ax.set_xticks(range(len(models)))\n",
    "ax.set_xticklabels(models, rotation=45, ha='right', fontsize=9)\n",
    "ax.set_ylabel('Expected Calibration Error', fontsize=11, fontweight='bold')\n",
    "ax.set_title('Calibration Quality Comparison', fontsize=12, fontweight='bold')\n",
    "ax.grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "for i, e in enumerate(eces):\n",
    "    ax.text(i, e + 0.002, f'{e:.4f}', ha='center', va='bottom', fontsize=8)\n",
    "\n",
    "import os\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join(FIGURES_DIR, 'calibration_curves.png'), dpi=300, bbox_inches='tight')\n",
    "print(f\"✓ Saved {os.path.join(FIGURES_DIR, 'calibration_curves.png')}\")\n"
    "plt.show()"
